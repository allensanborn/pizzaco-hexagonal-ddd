@startuml
title <size:24>Container View: Pizzaco Order Service</size>\n<size:24>Level 2, as-built. One Spring Boot deployable plus an in-memory database. Everything else is outside the boundary.</size>

set separator none
top to bottom direction
skinparam ranksep 60
skinparam nodesep 15
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Database,Ephemeral
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2UsRXBoZW1lcmFs {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 10-10;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #08427b;
    LineColor: #052e56;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person,Stopgap
  .Element-RWxlbWVudCxQZXJzb24sU3RvcGdhcA== {
    BackgroundColor: #6b5b95;
    LineColor: #4a3f68;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,External,Planned
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwsUGxhbm5lZA== {
    BackgroundColor: #ffffff;
    LineColor: #b2b2b2;
    LineStyle: 2-2;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #999999;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,External,Simulated
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwsU2ltdWxhdGVk {
    BackgroundColor: #b0b0b0;
    LineColor: #7b7b7b;
    LineStyle: 10-10;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Planned
  .Relationship-UmVsYXRpb25zaGlwLFBsYW5uZWQ= {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #999999;
    FontColor: #999999;
