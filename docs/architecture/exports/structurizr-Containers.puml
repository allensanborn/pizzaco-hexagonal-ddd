  .Boundary-UGl6emFjbyBPcmRlciBTZXJ2aWNl {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #1168bd;
    FontSize: 24;
