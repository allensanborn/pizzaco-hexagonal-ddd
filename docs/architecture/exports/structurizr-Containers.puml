person "==Customer\n<size:16>[Person]</size>\n\nOrders pizza and tracks it. Inferred: the API has no authentication." <<Element-RWxlbWVudCxQZXJzb24=>> as Customer
person "==Store Operator\n<size:16>[Person]</size>\n\nAdvances order status by hand. A stand-in for the kitchen and delivery contexts." <<Element-RWxlbWVudCxQZXJzb24sU3RvcGdhcA==>> as StoreOperator
rectangle "==Stripe\n<size:16>[Software System]</size>\n\nCard payment gateway. Named by the adapter, never contacted." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwsU2ltdWxhdGVk>> as Stripe
rectangle "==Google Maps Platform\n<size:16>[Software System]</size>\n\nTravel-time source for the ETA. Named by the adapter, never contacted." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwsU2ltdWxhdGVk>> as GoogleMapsPlatform
rectangle "==Firebase Cloud Messaging\n<size:16>[Software System]</size>\n\nPush channel for order updates. Named by the adapter, never contacted." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwsU2ltdWxhdGVk>> as FirebaseCloudMessaging
rectangle "==Kitchen Context\n<size:16>[Software System]</size>\n\nPLANNED. Does not exist in this repo. Should own baking progress." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwsUGxhbm5lZA==>> as KitchenContext
rectangle "==Delivery Context\n<size:16>[Software System]</size>\n\nPLANNED. Does not exist in this repo. Should own the courier." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwsUGxhbm5lZA==>> as DeliveryContext

rectangle "Pizzaco Order Service\n<size:16>[Software System]</size>" <<Boundary-UGl6emFjbyBPcmRlciBTZXJ2aWNl>> {
  database "==Order Store\n<size:16>[Container: H2 (in-memory)]</size>\n\nOne denormalised row per order, items as JSON. In-memory: lost on restart." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2UsRXBoZW1lcmFs>> as PizzacoOrderService.OrderStore
  rectangle "==Order API\n<size:16>[Container: Java 21 / Spring Boot 3]</size>\n\nSpring-free hexagonal core wrapped in web, persistence and integration adapters. Enforced by an ArchUnit test." <<Element-RWxlbWVudCxDb250YWluZXI=>> as PizzacoOrderService.OrderAPI
}

Customer --> PizzacoOrderService.OrderAPI <<Relationship-UmVsYXRpb25zaGlw>> : "Places an order, then polls its status\n<size:16>[JSON/HTTPS]</size>"
StoreOperator --> PizzacoOrderService.OrderAPI <<Relationship-UmVsYXRpb25zaGlwLFN0b3BnYXA=>> : "Advances the order lifecycle by hand\n<size:16>[JSON/HTTPS]</size>"
PizzacoOrderService.OrderAPI --> PizzacoOrderService.OrderStore <<Relationship-UmVsYXRpb25zaGlw>> : "Reads from and writes to\n<size:16>[SQL/JDBC]</size>"
PizzacoOrderService.OrderAPI --> Stripe <<Relationship-UmVsYXRpb25zaGlw>> : "Would authorise payment against\n<size:16>[SIMULATED]</size>"
PizzacoOrderService.OrderAPI --> GoogleMapsPlatform <<Relationship-UmVsYXRpb25zaGlw>> : "Would request travel time from\n<size:16>[SIMULATED]</size>"
PizzacoOrderService.OrderAPI --> FirebaseCloudMessaging <<Relationship-UmVsYXRpb25zaGlw>> : "Would push the update to\n<size:16>[SIMULATED]</size>"
KitchenContext --> PizzacoOrderService.OrderAPI <<Relationship-UmVsYXRpb25zaGlwLFBsYW5uZWQ=>> : "Should report Baking and ReadyForDelivery to\n<size:16>[PLANNED, event-driven]</size>"
DeliveryContext --> PizzacoOrderService.OrderAPI <<Relationship-UmVsYXRpb25zaGlwLFBsYW5uZWQ=>> : "Should report OutForDelivery and Delivered to\n<size:16>[PLANNED, event-driven]</size>"

@enduml