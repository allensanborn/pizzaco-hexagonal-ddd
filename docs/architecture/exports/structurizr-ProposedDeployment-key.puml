</style>

rectangle "==Proposed" <<DeploymentNode-RWxlbWVudCxQcm9wb3NlZA==>>

rectangle "==Container" <<Element-RWxlbWVudCxDb250YWluZXI=>>

database "==Container, Database, Planned" <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2UsUGxhbm5lZA==>>

rectangle "==Proposed" <<Element-RWxlbWVudCxQcm9wb3NlZA==>>

rectangle "." <<.Element-Transparent>> as 1
1 --> 1 <<Relationship-UmVsYXRpb25zaGlw>> : "Relationship"

rectangle "." <<.Element-Transparent>> as 2
2 --> 2 <<Relationship-UmVsYXRpb25zaGlwLFBsYW5uZWQ=>> : "Planned"

@enduml