rectangle "Pizzaco Order Service\n<size:16>[Software System]</size>" <<Boundary-UGl6emFjbyBPcmRlciBTZXJ2aWNl>> {
  rectangle "Order API\n<size:16>[Container: Java 21 / Spring Boot 3]</size>" <<Boundary-T3JkZXIgQVBJ>> {
    rectangle "Application / Use Cases (core.application)" <<Group-QXBwbGljYXRpb24gLyBVc2UgQ2FzZXMgKGNvcmUuYXBwbGljYXRpb24p>> as group1 {
      rectangle "==Place Order Service\n<size:16>[Component: Plain Java, no Spring]</size>\n\nPlaceOrderUseCase: validate, ETA, price, charge, confirm, persist, notify." <<Element-RWxlbWVudCxDb21wb25lbnQsVXNlQ2FzZQ==>> as PizzacoOrderService.OrderAPI.PlaceOrderService
      rectangle "==Progress Order Service\n<size:16>[Component: Plain Java, no Spring]</size>\n\nProgressOrderUseCase: drives the guarded lifecycle transitions." <<Element-RWxlbWVudCxDb21wb25lbnQsVXNlQ2FzZQ==>> as PizzacoOrderService.OrderAPI.ProgressOrderService
      rectangle "==Get Order Service\n<size:16>[Component: Plain Java, no Spring]</size>\n\nGetOrderUseCase: flattens the aggregate into an OrderView." <<Element-RWxlbWVudCxDb21wb25lbnQsVXNlQ2FzZQ==>> as PizzacoOrderService.OrderAPI.GetOrderService
    }

    rectangle "Domain (core.domain)" <<Group-RG9tYWluIChjb3JlLmRvbWFpbik=>> as group2 {
      rectangle "==PizzaOrder Aggregate\n<size:16>[Component: Plain Java + value objects]</size>\n\nImmutable aggregate root. Owns the lifecycle invariants." <<Element-RWxlbWVudCxDb21wb25lbnQsRG9tYWlu>> as PizzacoOrderService.OrderAPI.PizzaOrderAggregate
      rectangle "==Order Validation Service\n<size:16>[Component: Domain service]</size>\n\nRejects empty items, bad quantities, missing address or contact." <<Element-RWxlbWVudCxDb21wb25lbnQsRG9tYWlu>> as PizzacoOrderService.OrderAPI.OrderValidationService
      rectangle "==Order Pricing Service\n<size:16>[Component: Domain service]</size>\n\nSums line totals; delegates the delivery fee." <<Element-RWxlbWVudCxDb21wb25lbnQsRG9tYWlu>> as PizzacoOrderService.OrderAPI.OrderPricingService
      rectangle "==Delivery Fee Calculator\n<size:16>[Component: Domain service]</size>\n\nFree delivery for 3+ pizzas within 5 miles, else a flat 5.00." <<Element-RWxlbWVudCxDb21wb25lbnQsRG9tYWlu>> as PizzacoOrderService.OrderAPI.DeliveryFeeCalculator
    }

    rectangle "Inbound Adapters (infrastructure.web)" <<Group-SW5ib3VuZCBBZGFwdGVycyAoaW5mcmFzdHJ1Y3R1cmUud2ViKQ==>> as group3 {
      rectangle "==Pizza Web Controller\n<size:16>[Component: Spring @RestController]</size>\n\nExposes POST /orders, POST /orders/{id}/progress and GET /orders/{id}." <<Element-RWxlbWVudCxDb21wb25lbnQsQWRhcHRlcg==>> as PizzacoOrderService.OrderAPI.PizzaWebController
    }

    rectangle "Outbound Adapters (infrastructure)" <<Group-T3V0Ym91bmQgQWRhcHRlcnMgKGluZnJhc3RydWN0dXJlKQ==>> as group4 {
      rectangle "==Order Repository\n<size:16>[Component: Spring @Component + Jackson]</size>\n\nOrderStore port. Maps the aggregate to OrderEntity, items as JSON." <<Element-RWxlbWVudCxDb21wb25lbnQsQWRhcHRlcg==>> as PizzacoOrderService.OrderAPI.OrderRepository
      rectangle "==Order JPA Repository\n<size:16>[Component: Spring Data JPA]</size>\n\nSpring Data CRUD on ORDER_ENTITY." <<Element-RWxlbWVudCxDb21wb25lbnQsQWRhcHRlcg==>> as PizzacoOrderService.OrderAPI.OrderJPARepository
      rectangle "==Stripe Payment Adapter\n<size:16>[Component: Spring @Component]</size>\n\nPaymentProcessor port. SIMULATED: always succeeds, no HTTP call." <<Element-RWxlbWVudCxDb21wb25lbnQsQWRhcHRlcixTaW11bGF0ZWQ=>> as PizzacoOrderService.OrderAPI.StripePaymentAdapter
      rectangle "==Google Maps ETA Adapter\n<size:16>[Component: Spring @Component]</size>\n\nEtaProcessor port. SIMULATED: always 30 minutes, no HTTP call." <<Element-RWxlbWVudCxDb21wb25lbnQsQWRhcHRlcixTaW11bGF0ZWQ=>> as PizzacoOrderService.OrderAPI.GoogleMapsETAAdapter
      rectangle "==Firebase Notification Adapter\n<size:16>[Component: Spring @Component]</size>\n\nNotificationPort. SIMULATED: logs only, no HTTP call." <<Element-RWxlbWVudCxDb21wb25lbnQsQWRhcHRlcixTaW11bGF0ZWQ=>> as PizzacoOrderService.OrderAPI.FirebaseNotificationAdapter
    }

  }

}

